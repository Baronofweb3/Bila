# Copy to .env.local and fill in. Never commit real values.

# Public (read by the dashboard)
NEXT_PUBLIC_BILA_CONTRACT_ID=your-contract.testnet
NEXT_PUBLIC_BILA_OWNER=your-owner.testnet
# 1 = mask account names on screen, 0 = show them
NEXT_PUBLIC_BILA_MASK=1

# Private (hosted MCP endpoint, agent role only)
BILA_AGENT_ACCOUNT=your-agent.testnet
# SHA-256 of the agent token (generate: printf %s "$TOKEN" | shasum -a 256)
BILA_AGENT_TOKEN_SHA256=
# Function-call key limited to request_payment on the BILA contract
BILA_AGENT_SECRET_KEY=
# Optional: your own NEAR testnet RPC
BILA_RPC_URL=
